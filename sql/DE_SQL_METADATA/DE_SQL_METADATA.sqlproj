<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="1.0.0" />
  <PropertyGroup>
    <Name>DE_SQL_METADATA</Name>
    <ProjectGuid>{759407A4-525B-4F32-B3EB-FE22CBFE6BB6}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlDbFabricDatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
  </PropertyGroup>
  <ItemGroup>
    <SqlCmdVariable Include="Environment">
      <DefaultValue>DEV</DefaultValue>
      <Value>$(SqlCmdVar__1)</Value>
    </SqlCmdVariable>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="md" />
    <Folder Include="md\StoredProcedures" />
    <Folder Include="md\Tables" />
    <Folder Include="Security" />
  </ItemGroup>
  <ItemGroup>
    <None Include="DE_SQL_METADATA.publish.xml" />
  </ItemGroup>
  <ItemGroup>
    <PostDeploy Include="Script.PostDeployment.sql" />
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>